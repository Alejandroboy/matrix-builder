// packages/web/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  created
  paid
  canceled
}

enum ProductType {
  personal // личный PDF-разбор
  compatibility // PDF совместимости пары
}

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(created)
  productType ProductType
  // Вход: { birthDateA, nameA, birthDateB?, nameB? }. Это персональные данные:
  // дата рождения + имя. Храним ровно столько, сколько нужно для повторной
  // генерации PDF по ссылке (7 дней), дальше обнуляется — см. purgedAt и
  // /api/cron/purge. После обнуления заказ остаётся как факт оплаты (для
  // бухгалтерии и 54-ФЗ), но без ПДн.
  input       Json?
  amount      Int // копейки

  // Момент согласия на обработку ПДн. Без него заказ не создаётся:
  // согласие фиксируется до записи данных, а не после.
  consentAt   DateTime
  // Почта покупателя: единственный способ получить документ, если вкладка закрыта.
  // Хранится дольше input — по ней восстанавливаем доступ и шлём чек.
  email       String?
  // Защита от повторной отправки: письмо уходит один раз, кто бы ни обнаружил
  // оплату первым — вебхук или опрос статуса.
  emailSentAt DateTime?

  // Robokassa требует ЧИСЛОВОЙ номер счёта: cuid не подходит.
  // Автоинкремент — наш InvId, по нему приходит подтверждение оплаты.
  invId Int @unique @default(autoincrement())

  // Идентификатор платежа у провайдера (у Robokassa — номер операции).
  providerPaymentId String?   @unique
  createdAt         DateTime  @default(now())
  paidAt            DateTime?
  // Когда input обнулён политикой хранения
  purgedAt          DateTime?

  @@index([status, createdAt])
  @@index([purgedAt, paidAt])
}

// Лид переходного периода: пара попала на аркан без контента —
// вместо продажи пустоты собираем email и шлём письмо, когда контент готов.
model Lead {
  id            String      @id @default(cuid())
  email         String
  productType   ProductType
  input         Json?
  missingArcana Int[]
  consentAt     DateTime
  createdAt     DateTime    @default(now())
  notifiedAt    DateTime?
  purgedAt      DateTime?

  @@index([notifiedAt, createdAt])
}
