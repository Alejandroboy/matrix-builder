# /home/deploy/matrix-builder/packages/web/.env
# Права: chmod 600 — внутри ключи и пароли.

DATABASE_URL="postgresql://matrix:ПАРОЛЬ_БАЗЫ@localhost:5432/matrix?schema=public"
APP_URL="https://matricasudba.ru"

# Длинные случайные строки: openssl rand -hex 32
DOWNLOAD_SECRET=""
CRON_SECRET=""

# Платежи. Пока ключей нет — оставить пустыми: заказы будут отдавать
# понятное «оплата временно недоступна» вместо ошибки.
# ВАЖНО: в production мок отключён принудительно, PAYMENTS_MODE тут не нужен.
ROBOKASSA_LOGIN=""
ROBOKASSA_PASSWORD1=""
ROBOKASSA_PASSWORD2=""
# 1 — тестовый режим Robokassa (нужны ТЕСТОВЫЕ пароли из ЛК)
ROBOKASSA_IS_TEST="1"

# Почта
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Матрица судьбы <no-reply@matricasudba.ru>"
